TESTFORGE_DATABASE_URL=sqlite:///./testforge.db
TESTFORGE_LEASE_SECONDS=60
TESTFORGE_AGENT_OFFLINE_SECONDS=90
TESTFORGE_CONTROL_API_KEY=replace-control-key
TESTFORGE_AGENT_API_KEY=replace-agent-key
TESTFORGE_ARTIFACT_ROOT=./work/artifacts
TESTFORGE_MAINTENANCE_INTERVAL_SECONDS=30

TESTFORGE_AGENT_NAME=local-agent
TESTFORGE_AGENT_API_URL=http://127.0.0.1:8000/api/v1
TESTFORGE_AGENT_LABELS_JSON={"os":"linux","browser":"chrome"}
TESTFORGE_AGENT_CPU_MILLIS=4000
TESTFORGE_AGENT_MEMORY_MB=8192
# 只能在独立高风险资源池开启，并为 Agent 配置 executor_pool=native。
TESTFORGE_AGENT_ALLOW_NATIVE_EXECUTION=false
